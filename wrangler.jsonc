{
	"name": "castletcg",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-08",
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"r2_buckets": [
		{
			"binding": "CARD_IMAGES",
			"bucket_name": "assets"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"UPSTASH_REDIS_REST_URL": "",
		"UPSTASH_REDIS_REST_TOKEN": "",
		"ENCRYPTION_SECRET": "",
		"WORKER_DEV_URL": ""
	},
	"routes": [
		{ "pattern": "tcg.creatorcastle.gg", "custom_domain": true, "zone_name": "creatorcastle.gg" }
	],
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "f394df472f0f4e939f6281aadbce9020"
		}
	],
	"unsafe": {
		"bindings": [
			{ "name": "RATE_LIMITER_BOOTSTRAP",   "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 50,  "period": 60 } },
			{ "name": "RATE_LIMITER_ADMIN_LOGIN",  "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 10,  "period": 60 } },
			{ "name": "RATE_LIMITER_ADMIN",        "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
			{ "name": "RATE_LIMITER_API",          "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PACK_OPENING_SESSIONS",
				"class_name": "PackOpeningSession"
			},
			{
				"name": "OBS_QUEUE_SESSIONS",
				"class_name": "OBSQueueSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"PackOpeningSession"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"OBSQueueSession"
			]
		}
	]
}